# انسخ هذا الملف إلى .env.local وعبّي القيم

# قاعدة البيانات
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoparts_db
# DB_SSL_REJECT_UNAUTHORIZED=false   # فقط لو مزوّد القاعدة يستخدم شهادة ذاتية التوقيع

# مفتاح توقيع الجلسات — 32 حرف أو أكثر. تقدر تولّده بالأمر:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# حساب الأدمن الرئيسي — ينشأ تلقائياً أول تشغيل إذا ما كان موجود
ADMIN_NAME=الإدارة
ADMIN_EMAIL=
ADMIN_PASSWORD=
