# انسخ هذا الملف إلى .env.local وعبّي القيم

# قاعدة البيانات
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoparts_db
# شهادة CA من مزوّد قاعدة البيانات (محتوى ملف ca.pem كامل) — مطلوبة لو المزوّد يستخدم شهادة خاصة مثل Aiven
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=false   # حل مؤقت فقط: يعطّل التحقق من الشهادة

# مفتاح توقيع الجلسات — 32 حرف أو أكثر. تقدر تولّده بالأمر:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# حساب الأدمن الرئيسي — ينشأ تلقائياً أول تشغيل إذا ما كان موجود
ADMIN_NAME=الإدارة
ADMIN_EMAIL=
ADMIN_PASSWORD=

# نظام التجار
# نسبة العمولة الافتراضية للتاجر الجديد (٪) — الأدمن يقدر يغيّرها لكل تاجر من لوحة "التجار"
DEFAULT_COMMISSION_RATE=10
# توكن Vercel Blob لرفع شعارات المحلات والسجلات التجارية وصور القطع
# ينضاف تلقائياً لما تسوي Blob Store من Vercel → Storage وتربطه بالمشروع
# محلياً بدونه: الملفات تنحفظ في public/uploads
# BLOB_READ_WRITE_TOKEN=
